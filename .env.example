# Copy to .env (or .env.local) and fill in. Never commit real keys.

# Gmail SMTP (Nodemailer). SMTP_PASS must be a Google App Password
# (Google Account > Security > 2-Step Verification > App passwords), not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Sender shown on contact-form emails. Gmail forces the address to SMTP_USER,
# so leave empty to use SMTP_USER, or set e.g. "Alfa Septics Website <you@gmail.com>".
CONTACT_FROM_EMAIL=

# Where contact requests are delivered.
CONTACT_TO_EMAIL=
