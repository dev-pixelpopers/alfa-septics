# Copy to .env.local and fill in. Never commit real keys.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Sender for contact-form emails. Must be on a domain verified in Resend.
# Until a domain is verified you can use "Alfa Septics Website <onboarding@resend.dev>",
# but Resend then only delivers to the email that owns the Resend account.
CONTACT_FROM_EMAIL="Alfa Septics Website <onboarding@resend.dev>"

# Where contact requests are delivered.
CONTACT_TO_EMAIL=alfaseptic@gmail.com
